listening-port=3478
tls-listening-port=5349
listening-ip=${turn4}
listening-ip=${turn6}
relay-ip=${turn4}
relay-ip=${turn6}
min-port=49160
max-port=49259
realm=${turn_domain}
server-name=${turn_domain}
fingerprint
use-auth-secret
userdb=/var/lib/runlink-turn/turn.sqlite
pidfile=/run/runlink-turn/turn.pid
# Shared secret is appended in /run/runlink-turn/turnserver.conf, never in IaC.
user-quota=4
total-quota=100
max-bps=1048576
bps-capacity=52428800
max-allocate-lifetime=600
max-allocate-timeout=30
stale-nonce=600
no-tcp-relay
no-multicast-peers
no-cli
no-tlsv1
no-tlsv1_1
cert=/etc/runlink/tls/fullchain.pem
pkey=/etc/runlink/tls/privkey.pem
# Disable coturn request logging; transport metadata is measured outside this process.
log-file=/dev/null
no-stdout-log
# C's public relay addresses are allowed by IP, with port bounds enforced by nftables.
allowed-peer-ip=${turn4}
allowed-peer-ip=${turn6}
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fec0::-feff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=ff00::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=${frontend4}
denied-peer-ip=${app4}
denied-peer-ip=${frontend6}
denied-peer-ip=${app6}

{
  "title": "Sort lists",
  "description": "Sorts the lines of text or CSV files together on the owner's machine.",
  "command": ["./sort.sh", "{order}", "{lists}"],
  "inputs": [
    { "name": "lists", "type": "file", "label": "Lists", "required": true, "multiple": true, "accept": ".txt,.csv", "maxBytes": 1000000 },
    { "name": "order", "type": "choice", "label": "Order", "options": ["ascending", "descending"], "default": "ascending" }
  ],
  "output": { "kind": "file", "label": "the sorted list", "name": "sorted.txt" },
  "progress": true,
  "timeout": 30
}
